---
import configs from '../configs';
---

<section id="page-nav" class="not-content" aria-label="分类导航">
	<div class="page-nav-track">
		{
			configs.map(({ title }) => (
				<a
					title={title}
					href={`#${title}`}
					class="nav-link"
					data-nav-title={title}
					data-nav-path={`#${title}`}
				>
					{title}
				</a>
			))
		}
	</div>
</section>

<style>
	#page-nav {
		position: sticky;
		top: var(--sl-nav-height, 4rem);
		z-index: 8;
		margin: 1rem -0.25rem 0.25rem;
		padding: 0.65rem 0.25rem;
		background: color-mix(in srgb, var(--sl-color-bg) 88%, transparent);
		backdrop-filter: blur(16px) saturate(160%);
		-webkit-backdrop-filter: blur(16px) saturate(160%);
	}

	.page-nav-track {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		gap: 0.5rem;
		overflow-x: auto;
		overflow-y: hidden;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
	}

	.page-nav-track::-webkit-scrollbar {
		display: none;
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: none;
		min-height: 2.25rem;
		padding: 0.3rem 0.9rem;
		border-radius: var(--radius-pill);
		border: 1px solid rgba(15, 23, 42, 0.08);
		background: var(--color-surface, #fffcf8);
		color: var(--color-black);
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
		cursor: pointer;
		transition:
			transform var(--duration-press) var(--ease-out),
			background-color var(--duration-ui) ease,
			border-color var(--duration-ui) ease,
			color var(--duration-ui) ease;
	}

	html[data-theme='dark'] .nav-link {
		border-color: rgba(255, 255, 255, 0.1);
		background: var(--color-surface-dark, #121920);
		color: var(--color-silver);
	}

	.nav-link:active {
		transform: scale(0.97);
	}

	.nav-link:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--color-brand) 45%, transparent);
		outline-offset: 2px;
	}

	@media (hover: hover) and (pointer: fine) {
		.nav-link:hover {
			border-color: color-mix(in srgb, var(--color-brand) 35%, transparent);
			background: color-mix(in srgb, var(--color-brand) 10%, transparent);
		}
	}

	.nav-link.is-active {
		background: var(--color-brand);
		border-color: var(--color-brand);
		color: #fff;
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-link {
			transition: background-color var(--duration-ui) ease, border-color var(--duration-ui) ease,
				color var(--duration-ui) ease;
		}

		.nav-link:active {
			transform: none;
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		#page-nav {
			background: var(--sl-color-bg);
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
		}
	}
</style>

<script>
	declare global {
		interface Window {
			gtag?: (...args: unknown[]) => void;
		}
	}

	const nav = document.getElementById('page-nav');
	if (nav) {
		const track = nav.querySelector<HTMLElement>('.page-nav-track') ?? nav;
		const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[data-nav-title]')];

		nav.addEventListener('click', (event) => {
			const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-nav-path]');
			if (!link) return;

			window.gtag?.('event', 'navigation_click', {
				navigation_path: link.dataset.navPath,
				navigation_title: link.dataset.navTitle,
			});

			const heading = document.getElementById(link.dataset.navTitle ?? '');
			if (!heading) return;

			event.preventDefault();
			setActive(link.dataset.navTitle ?? null);
			heading.scrollIntoView({ behavior: 'auto', block: 'start' });
			history.pushState(null, '', link.dataset.navPath);
		});

		const visible = new Map<string, number>();
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		let currentTitle: string | null = null;
		setActive(links[0]?.dataset.navTitle ?? null);

		function scrollLinkHorizontally(link: HTMLAnchorElement) {
			const navRect = track.getBoundingClientRect();
			const linkRect = link.getBoundingClientRect();
			const maxScroll = track.scrollWidth - track.clientWidth;
			if (maxScroll <= 0) return;

			const inset = 12;
			const fullyVisible =
				linkRect.left >= navRect.left + inset && linkRect.right <= navRect.right - inset;
			if (fullyVisible) return;

			const delta = linkRect.left - navRect.left - (track.clientWidth - linkRect.width) / 2;
			track.scrollTo({
				left: Math.max(0, Math.min(maxScroll, track.scrollLeft + delta)),
				behavior: prefersReducedMotion.matches ? 'auto' : 'smooth',
			});
		}

		function setActive(title: string | null) {
			if (!title) return;
			const changed = title !== currentTitle;
			currentTitle = title;
			for (const link of links) {
				const isActive = link.dataset.navTitle === title;
				link.classList.toggle('is-active', isActive);
				if (isActive) {
					link.setAttribute('aria-current', 'location');
					if (changed) scrollLinkHorizontally(link);
				} else {
					link.removeAttribute('aria-current');
				}
			}
		}

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						visible.set(entry.target.id, entry.intersectionRatio);
					} else {
						visible.delete(entry.target.id);
					}
				}

				let best: string | null = null;
				let bestRatio = 0;
				for (const [id, ratio] of visible) {
					if (ratio >= bestRatio) {
						best = id;
						bestRatio = ratio;
					}
				}
				setActive(best);
			},
			{ rootMargin: '-18% 0px -68% 0px', threshold: [0, 0.15, 0.35, 0.6, 1] },
		);

		for (const link of links) {
			const heading = document.getElementById(link.dataset.navTitle ?? '');
			if (heading) observer.observe(heading);
		}
	}
</script>
