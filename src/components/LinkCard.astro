---
interface Props {
	title: string;
	link: string;
	desc: string;
	stars?: number;
	declining?: boolean;
}

const { title, link, desc, stars = 0, declining = false } = Astro.props;
const href = declining ? undefined : `${link}?ref=niceshare.site`;
const starCount = stars > 0 ? Math.min(stars, 5) : 0;
---

<div class:list={['link-card', 'not-content', declining && 'link-card--declining']}>
	{
		declining ? (
			<span class="link-card__inner link-card__inner--disabled">
				<h3 class="link-card__title">{title}</h3>
				<p class="link-card__desc">{desc}</p>
				{starCount > 0 && (
					<div class="link-card__stars">
						{Array.from({ length: starCount }).map(() => (
							<svg class="link-card__star" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 22 20">
								<path d="M20.924 7.625a1.52 1.52 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.52 1.52 0 0 0 .387-1.575" />
							</svg>
						))}
					</div>
				)}
			</span>
		) : (
			<a href={href} target="_blank" rel="noopener" class="link-card__inner">
				<h3 class="link-card__title">{title}</h3>
				<p class="link-card__desc">{desc}</p>
				{starCount > 0 && (
					<div class="link-card__stars">
						{Array.from({ length: starCount }).map(() => (
							<svg class="link-card__star" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 22 20">
								<path d="M20.924 7.625a1.52 1.52 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.52 1.52 0 0 0 .387-1.575" />
							</svg>
						))}
					</div>
				)}
			</a>
		)
	}
</div>

<style>
	.link-card {
		position: relative;
		border-radius: 1rem;
		padding: 1.25rem;
		border: 1px solid rgba(15, 23, 42, 0.06);
		background: #fff;
		box-shadow: var(--shadow-custom-white);
		/* Use translate/scale so hover does not override CardGrid stagger's transform. */
		transition:
			translate var(--duration-press) var(--ease-out),
			scale var(--duration-press) var(--ease-out),
			box-shadow var(--duration-ui) var(--ease-out),
			border-color var(--duration-ui) ease;
	}

	html[data-theme='dark'] .link-card {
		border-color: rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.02);
		box-shadow: var(--shadow-custom-dark);
	}

	.link-card--declining {
		cursor: not-allowed;
		opacity: 0.6;
	}

	.link-card:has(.link-card__inner:not(.link-card__inner--disabled):active) {
		scale: 0.97;
	}

	@media (hover: hover) and (pointer: fine) {
		.link-card:has(.link-card__inner:not(.link-card__inner--disabled):hover) {
			border-color: rgba(15, 23, 42, 0.1);
			box-shadow: var(--shadow-custom-white-xl);
			translate: 0 -2px;
		}

		html[data-theme='dark'] .link-card:has(.link-card__inner:not(.link-card__inner--disabled):hover) {
			border-color: rgba(255, 255, 255, 0.16);
			box-shadow: var(--shadow-custom-dark-xl);
		}

		.link-card:has(.link-card__inner:not(.link-card__inner--disabled):hover) .link-card__title {
			color: var(--color-brand);
		}
	}

	.link-card__inner {
		display: block;
		text-decoration: none;
		border-radius: 0.5rem;
	}

	.link-card__inner:not(.link-card__inner--disabled) {
		cursor: pointer;
	}

	.link-card__inner:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--color-brand) 45%, transparent);
		outline-offset: 4px;
	}

	.link-card__inner--disabled {
		pointer-events: none;
	}

	.link-card__title {
		color: var(--color-black);
		letter-spacing: -0.015em;
		transition: color var(--duration-press) ease;
	}

	html[data-theme='dark'] .link-card__title {
		color: var(--color-silver);
	}

	.link-card__desc {
		margin-top: 0.5rem;
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.6;
		text-decoration: none;
		color: var(--color-grey);
	}

	html[data-theme='dark'] .link-card__desc {
		color: rgb(156 163 175);
	}

	.link-card__stars {
		position: absolute;
		top: 0.25rem;
		right: 0.5rem;
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		align-items: center;
		gap: 0.125rem;
		margin: 0;
	}

	.link-card__star {
		display: block;
		flex: none;
		width: 1rem;
		height: 1rem;
		margin: 0;
		max-width: none;
		color: rgb(253 224 71);
	}

	@media (prefers-reduced-motion: reduce) {
		.link-card {
			transition: border-color var(--duration-ui) ease, box-shadow var(--duration-ui) ease;
		}

		.link-card:has(.link-card__inner:not(.link-card__inner--disabled):active),
		.link-card:has(.link-card__inner:not(.link-card__inner--disabled):hover) {
			translate: none;
			scale: none;
		}
	}
</style>
